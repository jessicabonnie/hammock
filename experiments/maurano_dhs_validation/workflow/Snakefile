# =============================================================================
# Snakefile — maurano_dhs_validation
# =============================================================================
#
# Sweeps Hammock Modes A/B/C/D over the 20-sample Maurano fetal DHS corpus
# and compares results against bedtools pairwise Jaccard ground truth.
#
# Pipeline:
#   prepare_data → A/B/C grid + Mode D grid (parallel)
#                                            ↓
#                                       analyze.R → figures/*.png + summaries
#
# Usage:
#   snakemake -n                                  # dry run
#   snakemake --cores 8                           # local
#   snakemake --profile workflow/slurm_profile/   # cluster
#
# All paths in this Snakefile are relative to the experiment directory.
# Invoke `snakemake -s workflow/Snakefile` from there, or use
# `sbatch_workflow.sh` which cd's first.
# =============================================================================

configfile: "workflow/config.yaml"

HAMMOCK         = config["hammock"]
THREADS_PER_RUN = int(config["threads_per_run"])

AB_PRECISIONS = config["ab_precisions"]
C_PRECISION   = int(config["c_precision"])
C_EXPA_VALS   = [f"{v:.2f}" for v in config["c_expA_values"]]
C_SUBB_VALS   = [f"{v:.2f}" for v in config["c_subB_values"]]

D_KS = config["d_ks"]
D_WS = config["d_ws"]
D_PS = config["d_precisions"]
# Filter (k, w) where w < k — Hammock emits a degenerate sketch in that case.
KW_PAIRS = [(k, w) for k in D_KS for w in D_WS if w >= k]

# Optional extended grid (low precision, large w on best-performing k's).
EXT_KS = config.get("extended_d_ks", [])
EXT_WS = config.get("extended_d_ws", [])
EXT_PS = config.get("extended_d_precisions", [])
EXT_KW = [(k, w) for k in EXT_KS for w in EXT_WS if w >= k]

wildcard_constraints:
    mode = r"[AB]",
    p    = r"\d+",
    expA = r"\d+\.\d+",
    subB = r"\d+\.\d+",
    k    = r"\d+",
    w    = r"\d+",

# ── Target file paths ────────────────────────────────────────────────────────
# "_full" tag matches the --metrics flag added to every rule's shell: block
# below -- python/hammock/outprefix.py now always tags Python-CLI output
# (_ie/_re/_full; docs/seed-metrics-column-restructure.md), and analyze.R's
# parse_abc_name/parse_d_name require this exact suffix.
AB_CSVS = expand("results/raw_abc/hammock_hll_p{p}_jacc{mode}_full.csv",
                 p=AB_PRECISIONS, mode=["A", "B"])
C_EXPA_CSVS = expand(
    "results/raw_abc/hammock_hll_p{p}_jaccC_expA{expA}_full.csv",
    p=[C_PRECISION], expA=C_EXPA_VALS)
C_SUBB_CSVS = expand(
    "results/raw_abc/hammock_hll_p{p}_jaccC_B{subB}_full.csv",
    p=[C_PRECISION], subB=C_SUBB_VALS)
ABC_CSVS = AB_CSVS + C_EXPA_CSVS + C_SUBB_CSVS

D_CSVS_BASE = [f"results/raw_d/hammock_mnmzr_p{p}_jaccD_k{k}_w{w}_full.csv"
               for p in D_PS for (k, w) in KW_PAIRS]
D_CSVS_EXT  = [f"results/raw_d/hammock_mnmzr_p{p}_jaccD_k{k}_w{w}_full.csv"
               for p in EXT_PS for (k, w) in EXT_KW]
# Union, preserving order, deduped.
D_CSVS = list(dict.fromkeys(D_CSVS_BASE + D_CSVS_EXT))

# Final products from analyze.R (declared as one targets group). The
# Mode C interpolation PNGs live in mode_c_interpolation.R — not produced
# by analyze.R, so they are not listed here.
FIGURES = [
    "figures/abc_pearson_vs_bedtools.png",
    "figures/mode_d_pearson_heatmap.png",
    "figures/mode_d_mae_heatmap.png",
    "figures/mode_d_best_scatter.png",
    "figures/mode_d_best_dendrogram.png",
    "figures/bedtools_dendrogram.png",
]
SUMMARIES = ["results/abc_summary.csv", "results/mode_d_summary.csv"]


# ── Targets ─────────────────────────────────────────────────────────────────
rule all:
    input:
        ABC_CSVS,
        D_CSVS,
        SUMMARIES,
        FIGURES,

rule sweep_abc:
    """Run only the A/B/C raw-CSV sweep (no analysis)."""
    input: ABC_CSVS

rule sweep_d:
    """Run only the Mode D raw-CSV sweep."""
    input: D_CSVS


# ── Data prep ───────────────────────────────────────────────────────────────
rule prepare_data:
    """Symlink BEDs/FASTAs from old hammock dir, build bedtools reference."""
    output:
        beds   = "data/maurano_files.txt",
        fastas = "data/maurano_fastas.txt",
        ref    = "data/maurano_bedtools_ref.tsv",
        key    = "data/maurano_filenames_key.tsv",
    log: "logs/prepare_data.log"
    resources:
        runtime    = 60,
        mem_mb     = 4000,
        cpus_per_task = 1,
    shell: "bash prepare_data.sh > {log} 2>&1"


# ── Modes A / B ─────────────────────────────────────────────────────────────
rule run_mode_ab:
    input:
        beds = "data/maurano_files.txt",
    output:
        "results/raw_abc/hammock_hll_p{p}_jacc{mode}_full.csv",
    log:
        "logs/abc/p{p}_{mode}.log",
    threads: THREADS_PER_RUN
    resources:
        runtime       = 120,
        mem_mb        = 8000,
        cpus_per_task = THREADS_PER_RUN,
    shell:
        "{HAMMOCK} {input.beds} {input.beds} "
        "--mode {wildcards.mode} --precision {wildcards.p} "
        "--threads {threads} "
        "--outprefix results/raw_abc/hammock "
        "--metrics "
        "> {log} 2>&1"


# ── Mode C — expA branch (subB stays at default 1.0) ────────────────────────
rule run_mode_c_expA:
    input:
        beds = "data/maurano_files.txt",
    output:
        "results/raw_abc/hammock_hll_p{p}_jaccC_expA{expA}_full.csv",
    log:
        "logs/abc/p{p}_C_expA{expA}.log",
    threads: THREADS_PER_RUN
    resources:
        runtime       = 120,
        mem_mb        = 8000,
        cpus_per_task = THREADS_PER_RUN,
    shell:
        "{HAMMOCK} {input.beds} {input.beds} "
        "--mode C --precision {wildcards.p} "
        "--expA {wildcards.expA} "
        "--threads {threads} "
        "--outprefix results/raw_abc/hammock "
        "--metrics "
        "> {log} 2>&1"


# ── Mode C — subB branch (expA = 0) ─────────────────────────────────────────
rule run_mode_c_subB:
    input:
        beds = "data/maurano_files.txt",
    output:
        "results/raw_abc/hammock_hll_p{p}_jaccC_B{subB}_full.csv",
    log:
        "logs/abc/p{p}_C_subB{subB}.log",
    threads: THREADS_PER_RUN
    resources:
        runtime       = 120,
        mem_mb        = 8000,
        cpus_per_task = THREADS_PER_RUN,
    shell:
        "{HAMMOCK} {input.beds} {input.beds} "
        "--mode C --precision {wildcards.p} "
        "--subB {wildcards.subB} "
        "--threads {threads} "
        "--outprefix results/raw_abc/hammock "
        "--metrics "
        "> {log} 2>&1"


# ── Mode D ──────────────────────────────────────────────────────────────────
rule run_mode_d:
    input:
        fastas = "data/maurano_fastas.txt",
    output:
        "results/raw_d/hammock_mnmzr_p{p}_jaccD_k{k}_w{w}_full.csv",
    log:
        "logs/d/p{p}_k{k}_w{w}.log",
    threads: THREADS_PER_RUN
    resources:
        # Mode D at p=24 on 20 FASTAs runs in ~5-10 min; bump time + mem a bit.
        runtime       = 240,
        mem_mb        = 16000,
        cpus_per_task = THREADS_PER_RUN,
    shell:
        "{HAMMOCK} {input.fastas} {input.fastas} "
        "--mode D --precision {wildcards.p} "
        "-k {wildcards.k} -w {wildcards.w} "
        "--threads {threads} "
        "--outprefix results/raw_d/hammock "
        "--metrics "
        "> {log} 2>&1"


# ── Summary + plots (analyze.R does everything in one shot) ─────────────────
rule analyze:
    input:
        ref     = "data/maurano_bedtools_ref.tsv",
        abc     = ABC_CSVS,
        d       = D_CSVS,
    output:
        SUMMARIES + FIGURES,
    log: "logs/analyze.log"
    envmodules:
        # Rockfish: r/4.3.0 sits under gcc/9.3.0; library(Cairo) needs
        # libjpeg.so.9 (see memory/feedback_load_r_module.md).
        "gcc/9.3.0",
        "r/4.3.0",
        "libjpeg/9c",
    resources:
        runtime       = 60,
        mem_mb        = 8000,
        cpus_per_task = 2,
    shell:
        "Rscript analyze.R > {log} 2>&1"
