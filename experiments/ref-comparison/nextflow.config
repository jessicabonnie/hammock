// nextflow.config — SLURM + Singularity for JHPCE cluster

// Keep work dir on /vast to avoid home quota limits
workDir = '/vast/blangme2/jbonnie/hammock/claude-ref-comparison/work'

process {
    executor = 'slurm'
    queue    = 'parallel'
    clusterOptions = '--account=blangme2_scal --exclude=bigmem23,c189,c712,c717'

    // Retry OOM failures with more memory
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    // Default resources
    cpus   = 1
    memory = { 8.GB * task.attempt }
    time   = '1h'

    // Per-label overrides (nf-core uses process labels)
    withLabel: process_low {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = '2h'
    }
    withLabel: process_medium {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = '4h'
    }
    withLabel: process_high {
        cpus   = 16
        memory = { 100.GB * task.attempt }
        time   = '8h'
        queue  = 'bigmem'
        clusterOptions = '--account=blangme2_bigmem --exclude=bigmem23,c189,c712,c717'
    }
}

singularity {
    enabled    = true
    autoMounts = true
    runOptions = '--bind /vast,/data'
}

// Limit concurrent SLURM jobs
executor {
    queueSize = 50
}
